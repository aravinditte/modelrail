# ModelRail — example environment. Copy to .env and replace every
# "change-me" placeholder locally. NEVER commit a real .env (spec §16.1).
# All values below are safe placeholders only — no real credentials.

# --- Persistence ---
# Host `postgres` is the Compose service name; use localhost outside Docker.
DATABASE_URL=postgresql+asyncpg://modelrail:change-me-local-only@postgres:5432/modelrail
POSTGRES_USER=modelrail
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=modelrail
REDIS_URL=redis://redis:6379/0

# --- Authentication ---
# Administrative API identity (spec §6.3). Separate from inference API keys.
ADMIN_TOKEN=change-me-generate-a-long-random-value
# Pepper mixed into gateway API-key hashes. Rotating it invalidates hashes.
MODELRAIL_API_KEY_PEPPER=change-me-generate-a-long-random-value

# --- Providers ---
# Optional local inference (disabled routes are skipped, not an error).
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Optional OpenAI-compatible remote provider — disabled while empty.
REMOTE_PROVIDER_BASE_URL=
REMOTE_PROVIDER_API_KEY=

# --- Timeouts and retries (seconds; spec §9) ---
PROVIDER_CONNECT_TIMEOUT_SECONDS=5
PROVIDER_REQUEST_TIMEOUT_SECONDS=60
OVERALL_REQUEST_DEADLINE_SECONDS=90
EVALUATION_JOB_DEADLINE_SECONDS=900
RETRY_MAX_ATTEMPTS=3

# --- Pricing / metering (spec §10.3) ---
PRICING_VERSION=2026-01-v1
DEFAULT_CURRENCY=USD

# --- Dashboard / observability ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local-only
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
